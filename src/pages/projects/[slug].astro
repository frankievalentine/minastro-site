---
import type { GetStaticPaths } from "astro";
import BackToTop from "../../components/BackToTop.astro";
import { projects, type ProjectFixture } from "../../data/fixtures";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = (() => projects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;
const { project } = Astro.props as { project: ProjectFixture };
const statusLabel: Record<string, string> = { active: "Active", wip: "WIP", archived: "Archived" };
---

<Layout title={project.title} description={project.description} currentPage={`/projects/${project.slug}`}>
  <div class="mx-auto max-w-2xl px-6 py-12 md:py-16">
    <a href="/projects" class="mb-8 inline-flex text-sm text-muted-foreground hover:text-foreground">All projects</a>
    <header class="mb-8"><div class="mb-3 flex flex-wrap items-center gap-2"><h1 class="text-3xl font-bold leading-tight tracking-tight text-foreground">{project.title}</h1><span class={project.status === "active" ? "badge-secondary text-xs" : "badge-outline text-xs"}>{statusLabel[project.status]}</span>{project.featured && <span class="badge-outline text-xs">Featured</span>}</div><p class="mb-4 leading-relaxed text-muted-foreground">{project.description}</p>{project.featuredImage && <img class="content-image mb-4 aspect-[16/9] w-full rounded-md object-cover" src={project.featuredImage.src} alt={project.featuredImage.alt} />}<div class="flex flex-wrap items-center gap-4">{project.github && <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground">GitHub</a>}{project.url && <a href={project.url} target="_blank" rel="noopener noreferrer" class="text-sm text-muted-foreground hover:text-foreground">Live site</a>}</div><div class="mt-4 flex flex-wrap gap-1.5">{project.tags.map((tag) => <span class="badge-outline text-xs">{tag}</span>)}</div></header>
    <div role="separator" class="mb-8 border-t border-border"></div><article class="article-prose">{project.content.map((paragraph) => <p>{paragraph}</p>)}</article><div role="separator" class="mb-8 mt-12 border-t border-border"></div><a href="/projects" class="text-sm text-muted-foreground hover:text-foreground">Back to all projects</a>
  </div>
  <BackToTop />
</Layout>
