---
import Layout from "../../layouts/Layout.astro";
import { examplePost, posts } from "../../data/fixtures";
import { formatDate, readingTime } from "../../utils";
---

<Layout title="Posts" currentPage="/posts">
  <div class="mx-auto max-w-2xl px-6 py-12 md:py-16">
    <div class="mb-3 flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg><span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Writing</span></div>
    <h1 class="mb-2 text-3xl font-bold tracking-tight">Posts</h1>
    <p class="mb-10 text-sm text-muted-foreground">Writing on engineering, projects, and ideas worth sharing.</p>

    <section aria-labelledby="post-example-heading" class="mb-12">
      <div class="mb-4"><p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Example output</p><h2 id="post-example-heading" class="mt-1 text-xl font-semibold tracking-tight">A complete post card</h2><p class="mt-1.5 text-sm text-muted-foreground">This static example shows how the template presents the available EmDash fields.</p></div>
      <a href="/posts/example" class="group block rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
        <article class="card overflow-hidden transition-colors group-hover:bg-accent/40"><section><img class="content-image mb-5 aspect-[16/9] w-full rounded-md object-cover" src={examplePost.featuredImage!.src} alt={examplePost.featuredImage!.alt} /><div class="flex items-start justify-between gap-4"><div class="min-w-0 flex-1"><div class="mb-2 flex flex-wrap items-center gap-2"><span class="badge-secondary text-xs">Rich content</span><span class="text-xs text-muted-foreground">Portable Text</span></div><h3 class="text-base font-semibold leading-snug text-foreground group-hover:underline">{examplePost.title}</h3><p class="mt-1 text-sm leading-relaxed text-muted-foreground">{examplePost.description}</p></div></div><div class="mt-4 flex flex-wrap items-center gap-2 text-xs text-muted-foreground"><time datetime={examplePost.publishedAt}>{formatDate(examplePost.publishedAt!)}</time><span aria-hidden="true">·</span><span>4 min read</span>{examplePost.tags.map((tag) => <span class="badge-outline text-xs">{tag}</span>)}</div></section></article>
      </a>
    </section>

    <section aria-labelledby="published-posts-heading">
      <div class="mb-4"><p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Published in EmDash</p><h2 id="published-posts-heading" class="mt-1 text-xl font-semibold tracking-tight">Latest posts</h2></div>
      <div class="grid gap-4">
        {posts.map((post) => <a href={`/posts/${post.slug}`} class="group block rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"><article class="card h-full transition-colors group-hover:bg-accent/40"><section>{post.featuredImage && <img class="content-image mb-4 aspect-[16/9] w-full rounded-md object-cover" src={post.featuredImage.src} alt={post.featuredImage.alt} loading="lazy" />}<div class="flex items-start justify-between gap-4"><div class="min-w-0 flex-1"><h3 class="mb-1 text-base font-semibold leading-snug text-foreground">{post.title}</h3><p class="line-clamp-2 text-sm leading-relaxed text-muted-foreground">{post.description}</p></div><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></div><div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-muted-foreground"><span>{post.publishedAt ? formatDate(post.publishedAt) : "Recently"}</span><span aria-hidden="true">·</span><span>{readingTime(post.content)}</span>{post.tags.map((tag) => <span class="badge-secondary text-xs">{tag}</span>)}</div></section></article></a>)}
      </div>
    </section>
  </div>
</Layout>
