---
import BackToTop from "../components/BackToTop.astro";
import { startHerePage } from "../data/fixtures";
import Layout from "../layouts/Layout.astro";
---

<Layout title={startHerePage.title} description={startHerePage.description} currentPage="/start-here">
  <div class="mx-auto max-w-2xl px-6 py-12 md:py-16">
    <header class="mb-8"><h1 class="mb-3 text-3xl font-bold leading-tight tracking-tight text-foreground">{startHerePage.title}</h1><p class="leading-relaxed text-muted-foreground">{startHerePage.description}</p></header>
    <div role="separator" class="mb-8 border-t border-border"></div><article class="article-prose">{startHerePage.content.map((paragraph) => <p>{paragraph}</p>)}</article>
  </div>
  <BackToTop />
</Layout>
