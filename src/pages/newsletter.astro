---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Newsletter" currentPage="/newsletter">
  <div class="mx-auto w-full max-w-lg px-6 py-12 md:py-16">
    <header class="mb-8 text-center"><div class="mb-3 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-muted-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>Newsletter</div><h1 class="text-2xl font-bold tracking-tight text-foreground">Stay in the loop</h1><p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-muted-foreground">Occasional notes on engineering, projects, and ideas. No spam.</p></header>
    <div class="mb-4 rounded-md border border-destructive bg-destructive/5 px-3 py-2 text-sm text-destructive" role="status"><strong class="font-semibold">Production signup is disabled.</strong> Enable the newsletter integration before subscribers can be collected.</div>
    <section aria-labelledby="signup-heading" class="card"><header><h2 id="signup-heading">Subscribe for new notes</h2><p>Get new writing and project updates in your inbox when there is something useful to share.</p></header><section><form class="grid gap-4"><div class="grid gap-2"><label for="newsletter-name" class="label">Name <span class="font-normal text-muted-foreground">(optional)</span></label><input id="newsletter-name" class="input disabled:cursor-not-allowed disabled:opacity-60" type="text" placeholder="Your name" disabled /></div><div class="grid gap-2"><label for="newsletter-email" class="label">Email address <span class="text-destructive" aria-hidden="true">*</span></label><input id="newsletter-email" class="input disabled:cursor-not-allowed disabled:opacity-60" type="email" placeholder="you@example.com" disabled aria-describedby="newsletter-email-help" /><p id="newsletter-email-help" class="text-xs text-muted-foreground">You can unsubscribe from any email.</p></div><button type="button" class="btn w-full" disabled><span>Subscribe</span><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg></button><p class="text-center text-xs leading-relaxed text-muted-foreground">By subscribing, you consent to receive this newsletter. Your email is used only for newsletter communications and can be removed at any time.</p></form></section></section>
    <section aria-labelledby="expect-heading" class="card mt-4"><header><h2 id="expect-heading">What to expect</h2></header><section><ul class="grid gap-4"><li class="flex gap-3"><span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-secondary text-secondary-foreground" aria-hidden="true">✎</span><div><h3 class="text-sm font-medium text-foreground">Engineering notes</h3><p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">Practical notes on building, debugging, and maintaining software.</p></div></li><li class="flex gap-3"><span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-secondary text-secondary-foreground" aria-hidden="true">□</span><div><h3 class="text-sm font-medium text-foreground">Project updates</h3><p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">Short updates on open-source work, experiments, and useful tools.</p></div></li><li class="flex gap-3"><span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-secondary text-secondary-foreground" aria-hidden="true">◷</span><div><h3 class="text-sm font-medium text-foreground">A focused pace</h3><p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">Occasional delivery, only when there is something worth sending.</p></div></li></ul></section></section>
  </div>
</Layout>
