---
import { searchEntries } from "../data/fixtures";

const searchJson = JSON.stringify(searchEntries).replaceAll("<", "\\u003c");
---

<dialog id="search-dialog" class="command-dialog" aria-labelledby="search-dialog-title">
  <div class="command">
    <header>
      <h2 id="search-dialog-title" class="sr-only">Search this preview</h2>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
      </svg>
      <input id="search-input" type="search" placeholder="Search this static preview" aria-label="Search this static preview" autocomplete="off" spellcheck="false" />
    </header>
    <div id="search-results" class="scrollbar min-h-20" aria-label="Search results">
      <p class="px-3 py-8 text-center text-sm text-muted-foreground">Search runs locally against the bundled example content.</p>
    </div>
    <p id="search-status" class="sr-only" role="status" aria-live="polite"></p>
  </div>
</dialog>

<script is:inline id="search-fixtures" type="application/json" set:html={searchJson}></script>

<script>
  interface SearchEntry {
    title: string;
    description: string;
    type: string;
    href: string;
  }

  const dialog = document.querySelector<HTMLDialogElement>("#search-dialog");
  const input = document.querySelector<HTMLInputElement>("#search-input");
  const results = document.querySelector<HTMLElement>("#search-results");
  const status = document.querySelector<HTMLElement>("#search-status");
  const fixtureScript = document.querySelector<HTMLScriptElement>("#search-fixtures");
  const entries: SearchEntry[] = fixtureScript?.textContent
    ? (JSON.parse(fixtureScript.textContent) as SearchEntry[])
    : [];
  let lastTrigger: HTMLElement | null = null;

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (character) => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;",
    })[character] ?? character);

  const showMessage = (message: string) => {
    if (results) results.innerHTML = `<p class="px-3 py-8 text-center text-sm text-muted-foreground">${escapeHtml(message)}</p>`;
  };

  const openSearch = (trigger?: HTMLElement | null) => {
    if (!dialog) return;
    lastTrigger = trigger ?? lastTrigger;
    if (!dialog.open) dialog.showModal();
    input?.focus();
  };

  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    const trigger = target?.closest<HTMLElement>("#search-trigger");
    if (trigger) openSearch(trigger);
    if (dialog && event.target === dialog) dialog.close();
  });

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      dialog?.open ? dialog.close() : openSearch();
    }
  });

  input?.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    if (query.length < 2) {
      showMessage(query ? "Keep typing to search." : "Search runs locally against the bundled example content.");
      if (status) status.textContent = "";
      return;
    }

    const matches = entries.filter((entry) =>
      `${entry.title} ${entry.description} ${entry.type}`.toLowerCase().includes(query),
    );
    if (!matches.length) {
      showMessage("No matching example content.");
      if (status) status.textContent = "No results found.";
      return;
    }

    if (results) {
      results.innerHTML = matches.map((entry) => `
        <a href="${entry.href}" class="block px-3 py-2.5 outline-none transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent focus-visible:text-accent-foreground">
          <span class="block text-sm font-medium">${escapeHtml(entry.title)}</span>
          <span class="mt-0.5 block text-[0.6875rem] uppercase tracking-wide text-muted-foreground">${escapeHtml(entry.type)}</span>
          <span class="mt-1 line-clamp-2 text-xs text-muted-foreground">${escapeHtml(entry.description)}</span>
        </a>
      `).join("");
    }
    if (status) status.textContent = `${matches.length} result${matches.length === 1 ? "" : "s"} found.`;
  });

  dialog?.addEventListener("close", () => lastTrigger?.focus());
</script>
