---
import Search from "../components/Search.astro";
import { navigation, site } from "../data/fixtures";
import "../styles/global.css";

interface Props {
  currentPage?: string;
  description?: string;
  title?: string;
}

const {
  currentPage = "/",
  description = site.description,
  title = site.title,
} = Astro.props;
const documentTitle = title === site.title ? title : `${title} • ${site.title}`;

const navIcons: Record<string, string> = {
  "/": `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline>`,
  "/posts": `<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path>`,
  "/projects": `<path d="M3 3h7v7H3z"></path><path d="M14 3h7v7h-7z"></path><path d="M14 14h7v7h-7z"></path><path d="M3 14h7v7H3z"></path>`,
  "/newsletter": `<rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>`,
  page: `<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M8 13h8"></path><path d="M8 17h6"></path>`,
};

function isActive(href: string): boolean {
  if (href === "/") return currentPage === "/";
  return currentPage === href || currentPage.startsWith(`${href}/`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.title} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d1f21" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline>
      (() => {
        try {
          const storedTheme = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", storedTheme === "dark" || (storedTheme !== "light" && prefersDark));
        } catch {
          document.documentElement.classList.toggle("dark", window.matchMedia("(prefers-color-scheme: dark)").matches);
        }
      })();
    </script>
  </head>
  <body class="min-h-svh bg-background text-foreground antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Search />

    <aside id="site-sidebar" class="sidebar" data-side="left" data-sidebar-initialized aria-hidden="false">
      <nav aria-label="Primary navigation">
        <header class="sidebar-mobile-header md:hidden">
          <span class="text-sm font-semibold">Navigation</span>
          <button id="sidebar-close" type="button" class="inline-flex size-9 items-center justify-center rounded-md hover:bg-sidebar-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sidebar-ring" aria-label="Close menu">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
          </button>
        </header>

        <section class="scrollbar">
          <div class="px-2 pt-2">
            <button id="search-trigger" type="button" aria-label="Search this static preview" class="flex h-8 w-full items-center gap-2 rounded-md border border-sidebar-border bg-sidebar-accent/60 px-2 text-sm text-muted-foreground transition-colors hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sidebar-ring">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
              <span class="flex-1 text-left text-xs">Search preview...</span>
              <span class="kbd hidden sm:inline-flex"><span>⌘</span><span>K</span></span>
            </button>
          </div>

          <div role="group">
            <ul>
              {navigation.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={navIcons[item.href] ?? navIcons.page}></svg>
                    <span>{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <footer>
          <details class="profile-menu">
            <summary class="flex h-12 w-full cursor-pointer list-none items-center gap-3 rounded-md p-2 text-left text-sm outline-none transition-colors hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:ring-2 focus-visible:ring-sidebar-ring">
              <img class="size-8 shrink-0 rounded-lg object-cover ring-1 ring-sidebar-border" src={site.avatar} alt={site.name} />
              <span class="grid min-w-0 flex-1 text-left leading-tight">
                <span class="truncate text-sm font-semibold text-sidebar-foreground">{site.name}</span>
                <span class="truncate text-xs text-muted-foreground">{site.tagline}</span>
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="profile-chevron shrink-0 text-muted-foreground" aria-hidden="true"><path d="m18 15-6-6-6 6"></path></svg>
            </summary>

            <div class="profile-panel w-56">
              <div class="py-1">
                <a href={site.social.github} target="_blank" rel="noopener noreferrer" class="profile-action">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
                  GitHub
                </a>
                <a href={site.social.twitter} target="_blank" rel="noopener noreferrer" class="profile-action">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l11.733 16H20L8.267 4z"></path><path d="M4 20L15.733 4"></path></svg>
                  X
                </a>
                <a href={`mailto:${site.social.email}`} class="profile-action">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                  Email
                </a>
              </div>
              <div class="border-t border-border py-1">
                <button id="theme-toggle" type="button" class="profile-action w-full">
                  <svg class="theme-icon-dark" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
                  <svg class="theme-icon-light" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
                  <span class="theme-label">Dark mode</span>
                </button>
              </div>
            </div>
          </details>
        </footer>
      </nav>
    </aside>

    <div class="flex min-h-svh flex-col">
      <header class="flex h-14 shrink-0 items-center gap-3 border-b border-border px-4 md:hidden">
        <button id="sidebar-open" type="button" aria-label="Open menu" aria-controls="site-sidebar" aria-expanded="false" class="inline-flex size-9 items-center justify-center rounded-md hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
        </button>
        <span class="text-sm font-semibold">{site.title}</span>
      </header>
      <main id="main-content" class="flex-1 pb-16" tabindex="-1"><slot /></main>
    </div>

    <script>
      const sidebar = document.querySelector<HTMLElement>("#site-sidebar");
      const openButton = document.querySelector<HTMLButtonElement>("#sidebar-open");
      const closeButton = document.querySelector<HTMLButtonElement>("#sidebar-close");
      const desktopQuery = window.matchMedia("(min-width: 768px)");
      const profileMenu = document.querySelector<HTMLDetailsElement>(".profile-menu");

      const setSidebar = (open: boolean, restoreFocus = false) => {
        sidebar?.setAttribute("aria-hidden", String(!open));
        openButton?.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("sidebar-open", open && !desktopQuery.matches);
        if (!open && profileMenu) profileMenu.open = false;
        if (open && !desktopQuery.matches) closeButton?.focus();
        if (!open && restoreFocus) openButton?.focus();
      };

      const syncSidebar = () => setSidebar(desktopQuery.matches);
      openButton?.addEventListener("click", () => setSidebar(true));
      closeButton?.addEventListener("click", () => setSidebar(false, true));
      sidebar?.addEventListener("click", (event) => {
        if (event.target === sidebar) setSidebar(false, true);
        if (!desktopQuery.matches && (event.target as Element).closest("nav a")) setSidebar(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !desktopQuery.matches && sidebar?.getAttribute("aria-hidden") === "false") setSidebar(false, true);
      });
      desktopQuery.addEventListener("change", syncSidebar);
      syncSidebar();

      // A native <details> only toggles from its <summary>, so close the profile
      // menu on outside click, Escape, or when one of its actions is chosen.
      document.addEventListener("click", (event) => {
        if (profileMenu?.open && !profileMenu.contains(event.target as Node)) profileMenu.open = false;
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !profileMenu?.open) return;
        profileMenu.open = false;
        profileMenu.querySelector("summary")?.focus();
      });
      profileMenu?.addEventListener("click", (event) => {
        if ((event.target as Element).closest(".profile-action")) profileMenu.open = false;
      });

      const themeToggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
      const themeLabel = document.querySelector<HTMLElement>(".theme-label");
      const updateThemeLabel = () => {
        if (themeLabel) themeLabel.textContent = document.documentElement.classList.contains("dark") ? "Light mode" : "Dark mode";
      };
      themeToggle?.addEventListener("click", () => {
        const isDark = !document.documentElement.classList.contains("dark");
        document.documentElement.classList.toggle("dark", isDark);
        try { localStorage.setItem("theme", isDark ? "dark" : "light"); } catch { /* Theme still applies for this visit. */ }
        updateThemeLabel();
      });
      updateThemeLabel();
    </script>
  </body>
</html>
